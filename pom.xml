<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.debthunter.controlplane</groupId>
  <artifactId>debt-hunter-control-plane</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Debt Hunter Control Plane</name>
  <description>
    The optional, asynchronous management and analytics control plane for Debt Hunter: ingests
    findings from CI/CD pipelines, maintains governance state, drives trend analytics, manages
    policy lifecycle, and surfaces portfolio dashboards.
  </description>

  <modules>
    <module>control-plane-testkit</module>
    <module>control-plane-store</module>
    <module>control-plane-ingest</module>
    <module>control-plane-analytics</module>
    <module>control-plane-governance</module>
    <module>control-plane-ai</module>
    <module>control-plane-egress</module>
    <module>control-plane-serve</module>
    <module>control-plane-api</module>
    <module>control-plane-app</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <archunit.version>1.3.0</archunit.version>

    <!-- Imported as a BOM only: Spring Boot's dependency management without making this project a
         Spring Boot parent, so that only control-plane-app applies the Boot build plugin. -->
    <spring-boot.version>3.5.16</spring-boot.version>

    <!-- The data-plane artifacts (debt-hunter's domain module) this project builds against. Not yet
         published to a registry: resolved from ~/.m2, so run `./mvnw install -pl domain` in the
         debt-hunter repository first. See README.md. -->
    <debt-hunter.version>0.1.0-SNAPSHOT</debt-hunter.version>

    <spotbugs-annotations.version>4.8.6</spotbugs-annotations.version>
    <!-- Not managed by the Spring Boot BOM. -->
    <json-schema-validator.version>1.5.9</json-schema-validator.version>

    <!-- Plugin versions (kept in step with the debt-hunter data-plane repository) -->
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
    <build-helper-maven-plugin.version>3.6.0</build-helper-maven-plugin.version>
    <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
    <spotless-maven-plugin.version>2.44.0</spotless-maven-plugin.version>
    <spotbugs-maven-plugin.version>4.8.6.5</spotbugs-maven-plugin.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    <maven-dependency-plugin.version>3.9.0</maven-dependency-plugin.version>

    <jacoco.line.coverage.minimum>0.80</jacoco.line.coverage.minimum>

    <!-- "integration" tests use real collaborators (Testcontainers: Kafka, PostgreSQL, Redis) and run
         via failsafe; "platform" tests need real cloud services (Key Vault, Entra, Azure OpenAI,
         an OCI registry) and never run by default. -->
    <surefire.excludedGroups>integration,platform</surefire.excludedGroups>
    <failsafe.groups>integration</failsafe.groups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-annotations</artifactId>
        <version>${spotbugs-annotations.version}</version>
      </dependency>

      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>

      <!-- Data plane -->
      <dependency>
        <groupId>com.debthunter</groupId>
        <artifactId>domain</artifactId>
        <version>${debt-hunter.version}</version>
      </dependency>
      <dependency>
        <groupId>com.debthunter</groupId>
        <artifactId>policy</artifactId>
        <version>${debt-hunter.version}</version>
      </dependency>

      <!-- Control-plane modules -->
      <dependency>
        <groupId>com.debthunter.controlplane</groupId>
        <artifactId>control-plane-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.debthunter.controlplane</groupId>
        <artifactId>control-plane-store</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.debthunter.controlplane</groupId>
        <artifactId>control-plane-ingest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.debthunter.controlplane</groupId>
        <artifactId>control-plane-analytics</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.debthunter.controlplane</groupId>
        <artifactId>control-plane-governance</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.debthunter.controlplane</groupId>
        <artifactId>control-plane-ai</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.debthunter.controlplane</groupId>
        <artifactId>control-plane-egress</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.debthunter.controlplane</groupId>
        <artifactId>control-plane-serve</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.debthunter.controlplane</groupId>
        <artifactId>control-plane-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Every module gets the test stack for free. Versions come from the Spring Boot BOM. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>21</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build-helper-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <excludedGroups>${surefire.excludedGroups}</excludedGroups>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <groups>${failsafe.groups}</groups>
            <includes>
              <include>**/*.java</include>
            </includes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>jacoco-prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-prepare-agent-integration</id>
              <goals>
                <goal>prepare-agent-integration</goal>
              </goals>
            </execution>
            <!-- Unit tests write jacoco.exec, integration tests write jacoco-it.exec; merge both
                 before reporting/checking so coverage from either counts. -->
            <execution>
              <id>jacoco-merge</id>
              <phase>verify</phase>
              <goals>
                <goal>merge</goal>
              </goals>
              <configuration>
                <fileSets>
                  <fileSet>
                    <directory>${project.build.directory}</directory>
                    <includes>
                      <include>jacoco.exec</include>
                      <include>jacoco-it.exec</include>
                    </includes>
                  </fileSet>
                </fileSets>
                <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
              </configuration>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
              <configuration>
                <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
              </configuration>
            </execution>
            <execution>
              <id>jacoco-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>${jacoco.line.coverage.minimum}</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-maven-plugin.version}</version>
          <configuration>
            <java>
              <includes>
                <include>src/main/java/**/*.java</include>
                <include>src/test/java/**/*.java</include>
                <include>src/integrationTest/java/**/*.java</include>
              </includes>
              <googleJavaFormat />
            </java>
          </configuration>
          <executions>
            <execution>
              <id>spotless-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
          <configuration>
            <failOnError>false</failOnError>
            <effort>Max</effort>
            <threshold>Medium</threshold>
          </configuration>
          <executions>
            <execution>
              <id>spotbugs-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-integration-test-source</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/integrationTest/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-integration-test-resource</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>add-test-resource</goal>
            </goals>
            <configuration>
              <resources>
                <resource>
                  <directory>src/integrationTest/resources</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
          <!-- Global rule 5: Spring Boot only in control-plane-app. All business logic lives in
               non-framework modules. Enforced mechanically, the way debt-hunter enforces domain
               purity: Spring Boot artifacts may not be on any other module's production classpath
               (test scope is allowed, e.g. spring-boot-test slices). control-plane-app switches
               this execution off. -->
          <execution>
            <id>enforce-boot-only-in-app</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework.boot:*:*:*:compile</exclude>
                    <exclude>org.springframework.boot:*:*:*:runtime</exclude>
                  </excludes>
                  <message>Spring Boot is only permitted in control-plane-app; business logic modules must stay free of it.</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
          <!-- Global rule: no model on the pipeline path. Only the serve layer and the application may
               depend on control-plane-ai; ingestion, storage, analytics, governance and the HTTP
               ingestion API may not, so nothing a pipeline waits on can reach a model. -->
          <execution>
            <id>enforce-no-ai-on-pipeline-path</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.debthunter.controlplane:control-plane-ai</exclude>
                  </excludes>
                  <message>control-plane-ai may only be used by control-plane-serve and control-plane-app.</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
