{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debthunter.com/schemas/control-plane/run-bundle-v1.schema.json",
  "title": "Debt Hunter run bundle, schema v1 (current)",
  "description": "What the control plane accepts from a pipeline. Derived from the data plane's debt-hunter.json v1, but a tolerant reader: required fields are enforced, unknown fields are allowed, so the data plane can add fields without breaking ingestion.",
  "type": "object",
  "required": ["schemaVersion", "run", "findings", "metrics", "policy"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "run": { "$ref": "#/$defs/run" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "metrics": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metric" } },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "id",
        "toolVersion",
        "timestamp",
        "repository",
        "commit",
        "historyDepth",
        "engines",
        "degraded"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "toolVersion": { "type": "string", "minLength": 1 },
        "imageDigest": { "type": ["string", "null"] },
        "timestamp": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "project": { "type": ["string", "null"] },
        "commit": { "type": "string" },
        "baseCommit": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "pullRequest": { "type": ["string", "null"] },
        "historyDepth": { "enum": ["FULL", "PARTIAL", "SHALLOW"] },
        "engines": { "type": "array", "items": { "$ref": "#/$defs/engineStatus" } },
        "degraded": { "type": "boolean" },
        "baselineProvenance": { "type": ["string", "null"] }
      }
    },
    "engineStatus": {
      "type": "object",
      "required": ["id", "version", "status", "durationMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["OK", "DEGRADED", "FAILED"] },
        "durationMs": { "type": "integer", "minimum": 0 },
        "reason": { "type": ["string", "null"] }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "ruleId",
        "category",
        "severity",
        "confidence",
        "path",
        "startLine",
        "message",
        "evidence",
        "score",
        "isNew",
        "fingerprint"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "HOTSPOT",
            "TEMPORAL_COUPLING",
            "CHURN",
            "KNOWLEDGE_CONCENTRATION",
            "ARCHITECTURE",
            "STATIC_ANALYSIS",
            "DEPENDENCY",
            "TEST_HEALTH",
            "CUSTOM"
          ]
        },
        "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 0 },
        "message": { "type": "string", "minLength": 1 },
        "evidence": { "type": "object" },
        "score": { "type": "number" },
        "isNew": { "type": "boolean" },
        "fingerprint": { "type": "string", "minLength": 1 }
      }
    },
    "metric": {
      "type": "object",
      "required": ["name", "value", "scope"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "policy": {
      "type": "object",
      "required": ["bundleVersion", "status", "reasons"],
      "properties": {
        "bundleVersion": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASSED", "FAILED", "WOULD_FAIL"] },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/policyViolation" } }
      }
    },
    "policyViolation": {
      "type": "object",
      "required": ["rule", "threshold", "actual", "findingIds"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "threshold": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 },
        "findingIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
