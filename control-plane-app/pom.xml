<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.debthunter.controlplane</groupId>
    <artifactId>debt-hunter-control-plane</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>control-plane-app</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.debthunter.controlplane</groupId>
      <artifactId>control-plane-api</artifactId>
    </dependency>
    <!-- Not wired into the running application yet; the offline-distribution test uses it. -->
    <dependency>
      <groupId>com.debthunter.controlplane</groupId>
      <artifactId>control-plane-governance</artifactId>
    </dependency>
    <!-- The only module permitted to put Spring Boot on its production classpath. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <!-- The connection pool for the system of record; the store modules take a plain DataSource. -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.debthunter.controlplane</groupId>
      <artifactId>control-plane-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Switch off the parent's "Spring Boot only in control-plane-app" rule: this is that module. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-boot-only-in-app</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!-- Keep the plain jar as the main artifact: repackaging it in place nests the
                   classes under BOOT-INF/, which breaks the integration tests (they run after
                   `package`, against that jar). The runnable jar is attached as *-exec.jar. -->
              <classifier>exec</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The integration tests run the real data-plane CLI as a separate process, exactly as a
           pipeline would. Copy its runnable jar out of the local Maven repository (run
           `./mvnw -pl cli -am install` in debt-hunter first; see README.md). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-data-plane-cli</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.debthunter</groupId>
                  <artifactId>cli</artifactId>
                  <version>${debt-hunter.version}</version>
                  <type>jar</type>
                  <destFileName>debt-hunter.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/data-plane</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <debthunter.dataplane.jar>${project.build.directory}/data-plane/debt-hunter.jar</debthunter.dataplane.jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- The Spring Boot entry point is pure wiring (SpringApplication.run); its context start-up
           is covered by ControlPlaneApplicationSmokeTest, but its main() cannot be exercised
           without launching a second application, so it is excluded from the coverage gate. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/ControlPlaneApplication.class</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
